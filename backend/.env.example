# Application Configuration
APP_NAME=SocialOpti AI Framework
APP_ENV=development
DEBUG=True
API_PREFIX=/api
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database URL
# PostgreSQL (Production / Local): postgresql://postgres:postgres@localhost:5432/socialopti_db
# SQLite (Fallback for local dev): sqlite:///./socialopti.db
DATABASE_URL=sqlite:///./socialopti.db

# Security & JWT Token
SECRET_KEY=socialopti_super_secret_jwt_key_2026_final_year_project_ai_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50
